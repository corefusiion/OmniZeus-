NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Chave master da OpenRouter usada como fallback quando a empresa nao tem chave propria
OPENROUTER_API_KEY=sk-or-v1-...

# Assinatura HMAC-SHA256 do cookie de sessao. OBRIGATORIO em producao (min. 32 chars).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Segredo do webhook do Stripe (whsec_...). Sem ele o webhook rejeita todos os eventos.
STRIPE_WEBHOOK_SECRET=

# Token compartilhado que a Evolution API deve enviar no header x-webhook-token
WHATSAPP_WEBHOOK_TOKEN=
